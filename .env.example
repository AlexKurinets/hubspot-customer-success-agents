# Host ports. Change any that are taken on your machine.
POSTGRES_PORT=5490
HUBSPOT_PORT=8150
API_PORT=8151
DASHBOARD_PORT=8550

# offline uses the deterministic stand-in; claude calls the Anthropic API and needs a key.
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
CS_LLM_MODEL=claude-sonnet-5-5

# Demo credentials for the HubSpot stand-in and the approval endpoint. Replace outside a local demo.
HUBSPOT_TOKEN=pat-demo-cs-agents
HUBSPOT_CLIENT_SECRET=demo-client-secret
APPROVER_TOKEN=demo-csm
